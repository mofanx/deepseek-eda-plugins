{
  "name": "@deepseek-ai/dsh-plugin-eda-core",
  "description": "Shared EasyEDA client machinery for the dsh-plugin-eda-* plugins: run-api-gateway bridge client and dsh-eda-bridge bin, workspace library, document-source read-back/netlist diff, and V3 SCH_PAGE/.epro2 serializers",
  "version": "0.1.0-alpha.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mofanx/deepseek-eda-plugins.git",
    "directory": "packages/eda-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-eda-bridge": "./bin/dsh-eda-bridge.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "bin/dsh-eda-bridge.mjs",
    "bin/http-guard.mjs",
    "bin/http-api.mjs"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-timeout": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-alpha.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-plugin-eda-sch": "workspace:*",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-eda-sch": "workspace:*",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-alpha.1 <0.3.0"
  }
}
