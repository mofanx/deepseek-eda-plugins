{
  "name": "@deepseek-ai/dsh-plugin-eda-easyeda",
  "description": "EasyEDA document-source engine for the schematic seam (ctx.schematic): projects the schematic IR to V3 SCH_PAGE source and delivers through the live client bridge",
  "version": "0.1.0-alpha.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mofanx/deepseek-eda-plugins.git",
    "directory": "packages/schematic-easyeda"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "scripts/live-verify.mjs"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <4.1.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-plugin-eda-core": "workspace:*",
    "@deepseek-ai/dsh-plugin-eda-sch": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/dsh-plugin-eda-core": "workspace:*",
    "@deepseek-ai/dsh-plugin-eda-sch": "workspace:*",
    "typescript": "^5.9.0"
  }
}
