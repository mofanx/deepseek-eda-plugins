{
  "name": "@deepseek-ai/dsh-plugin-eda-bundle",
  "description": "Optional profile layer that mounts the schematic-generation capability seam, the EasyEDA engine, and its model tools.",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-plugin-eda-sch": "workspace:*",
    "@deepseek-ai/dsh-plugin-eda-easyeda": "workspace:*",
    "@deepseek-ai/dsh-plugin-eda-sch-gen": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "typescript": "^5.9.0"
  }
}
